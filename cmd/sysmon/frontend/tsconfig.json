{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "types": [],
    "paths": {
      "$lib/*": [
        "./src/lib/*"
      ],
      "$stores/*": [
        "./src/stores/*"
      ],
      "$components/*": [
        "./src/components/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.svelte",
    "public/**/*.js"
  ]
}
