{
    "server-address": {
        "type": "entry",
        "default": "localhost:8080",
        "description": "Sysmon server address (host:port)"
    },
    "update-interval": {
        "type": "combobox",
        "default": 1000,
        "options": {
            "500 ms": 500,
            "1 second": 1000,
            "5 seconds": 5000,
            "10 seconds": 10000,
            "15 seconds": 15000,
            "30 seconds": 30000,
            "1 minute": 60000
        },
        "description": "Update interval"
    },
    "show-cpu": {
        "type": "switch",
        "default": true,
        "description": "Show CPU gauge"
    },
    "show-memory": {
        "type": "switch",
        "default": true,
        "description": "Show memory gauge"
    },
    "show-network": {
        "type": "switch",
        "default": true,
        "description": "Show network throughput"
    },
    "show-disk": {
        "type": "switch",
        "default": true,
        "description": "Show disk usage"
    }
}
