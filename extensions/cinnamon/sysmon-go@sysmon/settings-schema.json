{
    "server-address": {
        "type": "entry",
        "default": "localhost:8080",
        "description": "Sysmon server address (host:port)"
    },
    "update-interval": {
        "type": "spinbutton",
        "default": 1000,
        "min": 500,
        "max": 60000,
        "step": 500,
        "description": "Update interval in milliseconds (the server accepts 500, 1000, 5000, 10000, 15000, 30000 or 60000)"
    },
    "show-cpu": {
        "type": "switch",
        "default": true,
        "description": "Show CPU gauge"
    },
    "show-memory": {
        "type": "switch",
        "default": true,
        "description": "Show memory gauge"
    },
    "show-network": {
        "type": "switch",
        "default": true,
        "description": "Show network throughput"
    },
    "show-disk": {
        "type": "switch",
        "default": true,
        "description": "Show disk usage"
    }
}
