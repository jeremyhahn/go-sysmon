# /etc/go-sysmon/sysmon.env
#
# Settings for the go-sysmon systemd service. `make deploy` copies this file
# into place the FIRST time it runs and never touches it again, so anything you
# change here survives every later deploy.
#
# Apply a change with:   sudo systemctl restart go-sysmon
#
# This is the only file the deployment creates that is not a build output.
# sysmon keeps no database, no history and no state directory -- it reads the
# host live -- so this file plus the unit is the entire installation footprint
# outside /usr/local/bin.
#
# Syntax is systemd's EnvironmentFile, not a shell script: KEY=value, no
# export, no command substitution, and quotes are taken literally unless they
# wrap the whole value. Commenting a line out is safe; the unit carries the
# same defaults.

# The address the dashboard listens on. "host:port", and an empty host means
# every interface.
#
# 8081 rather than the binary's own default of 8080, because 8080 belongs to
# the other services this host is likely to be running. Check what is already
# listening before you change it -- two services on one port is a straight
# bind failure at boot, and the loser is whichever starts second:
#
#     ss -ltnp
#
# THE DASHBOARD HAS NO AUTHENTICATION. It publishes the hostname, the full
# process list with command lines, disk serial numbers and network layout. On
# any network you do not control, bind one private address here rather than
# every interface, and put an authenticating proxy in front of it:
#
#     SYSMON_ADDR=10.0.0.5:8081
SYSMON_ADDR=:8081

# How often the host is polled, in milliseconds.
#
# CPU cost is very nearly linear in this. Measured on a 4-thread 1.66GHz Atom:
# 1000ms cost 16.1% of one core, 2000ms cost 7.8%, 5000ms cost 3.9%. Memory did
# not move. 2000 is the shipped default because a metrics dashboard is not
# improved by sub-second resolution nearly as much as a shared host is hurt by
# it; drop it to 1000 on a machine with cores to spare.
SYSMON_INTERVAL=2000

# debug, info, warn or error. debug is loud -- it logs every collection cycle.
SYSMON_LOG_LEVEL=info
