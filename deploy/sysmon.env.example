# /etc/go-sysmon/sysmon.env
#
# Settings for the go-sysmon systemd service. `make deploy` installs this file
# only when it is absent, so local changes survive later deploys.
# Apply a change with: sudo systemctl restart go-sysmon
#
# systemd EnvironmentFile syntax: KEY=value, no export, no command
# substitution. A commented-out line falls back to the unit's default.

# Listen address, "host:port"; an empty host means every interface.
# The dashboard has no authentication and publishes the process list, disk
# serials and network layout: on an untrusted network bind a private address
# and put an authenticating proxy in front of it, for example:
#     SYSMON_ADDR=10.0.0.5:8081
SYSMON_ADDR=:8081

# Poll interval in milliseconds. CPU cost scales roughly linearly with the rate.
SYSMON_INTERVAL=2000

# debug, info, warn or error. debug logs every collection cycle.
SYSMON_LOG_LEVEL=info
