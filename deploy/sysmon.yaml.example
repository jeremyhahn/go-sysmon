# go-sysmon configuration. Copy to /etc/go-sysmon/sysmon.yaml.
#
# Precedence, lowest to highest: built-in defaults, this file, SYSMON_*
# environment variables, command-line flags. The dashboard's Settings tab shows
# every effective value and which of those supplied it.
#
# Apply changes without restarting:   systemctl reload go-sysmon
# (Reload covers alert thresholds, fleet peers, the poll interval and the whole
# prometheus section. The listen address and TLS files bind at startup and still
# need a restart.)

server:
  addr: ":8081"
  interval_ms: 2000
  # Re-read this file automatically when it changes on disk. Otherwise reload
  # with `systemctl reload go-sysmon` (SIGHUP). There is no HTTP reload
  # endpoint: this service carries no authentication of its own and sits behind
  # an authenticating proxy, so nothing over HTTP changes its configuration.
  watch: false

alerts:
  # A threshold of 0 disables its rule. A degraded RAID array and a failing
  # SMART attribute are always evaluated and are not listed here: there is no
  # sensible value at which those should be ignored.

  # --- storage ---
  disk_full_pct: 90        # filesystem usage, warning
  disk_full_crit_pct: 95   # filesystem usage, critical
  disk_util_pct: 90        # %util (device busy), warning
  disk_queue_len: 8        # average requests queued -- what latency follows
  temp_warn_c: 70
  temp_crit_c: 85
  nvme_wear_pct: 80        # NVMe wear level used, warning
  nvme_spare_pct: 10       # NVMe spare blocks remaining, critical below this

  # --- cpu and memory ---
  cpu_pct: 90              # mean usage across logical CPUs
  load_per_core: 2.0
  memory_pct: 90
  # A paging RATE, not an occupancy: swap that is merely resident costs nothing,
  # and pages left behind by a burst that ended hours ago stay counted until
  # something reclaims them. 200 pages/s is 800 KB/s at the usual 4 KiB page.
  swap_out_pages_per_sec: 200
  psi_full_avg10: 10       # "full" pressure (cpu/memory/io): everything stalled

  # --- network ---
  iface_err_rate: 1        # interface errors+drops per second
  net_util_pct: 80         # share of the link speed, where the speed is known

  # --- gpu ---
  # Looser than the CPU equivalents on purpose: an accelerator under load is
  # designed to run hot and near its power limit. High utilisation is
  # deliberately not an alert -- that is the card doing its job.
  gpu_temp_warn_c: 85
  gpu_temp_crit_c: 95
  gpu_memory_pct: 90       # exhausted video memory fails work outright
  gpu_power_pct: 95        # share of the card's power limit

  # --- containers ---
  container_mem_pct: 90    # share of the container's own memory limit
  container_cpu_pct: 90

  # Per-resource exceptions, for a device whose normal state would otherwise
  # alert forever. Only the keys you set are overridden.
  overrides:
    - resource: md0
      disk_full_pct: 98
      disk_full_crit_pct: 99
      # disk_util_pct / disk_queue_len / temp_warn_c / temp_crit_c also
      # accepted here.

# Peers turn this node into a fleet aggregator: the dashboard opens on a fleet
# view of itself plus the nodes below, and any node can be drilled into without
# the browser leaving this origin. Leave empty and the node behaves exactly as a
# standalone dashboard.
fleet:
  # How this node names itself in the fleet view. Defaults to the hostname,
  # which is usually right -- but a machine repurposed from an earlier role can
  # carry a hostname that no longer describes it, and relabelling a dashboard is
  # cheaper than renaming a running host. Held to the same rule as a peer name
  # below: letters, digits, '.', '_', ':' and '-' only, or the service will not
  # start -- and if this is unset and the hostname breaks that rule, set it.
  # local_name: netmon
  poll_interval_ms: 10000
  timeout_ms: 3000
  peers: []
  # A peer's name is its fleet-wide identity: set it to exactly what that node
  # calls itself (its fleet.local_name, or its hostname), because it is also the
  # Prometheus instance label its history is stored under. Letters, digits,
  # '.', '_', ':' and '-' only; anything else stops the service at startup.
  # name is required: a peer without one stops the service at startup, because
  # the name is published on the dashboard's unauthenticated endpoints and a
  # default would have to be taken from the peer's address.
  # peers:
  #   - name: fs
  #     url: http://198.51.100.10:8081
  #   - name: omega
  #     url: http://198.51.100.90:8081

# ---------------------------------------------------------------------------
# Prometheus (optional)
# ---------------------------------------------------------------------------
#
# Leave this section out entirely and the node behaves exactly as it always
# has: real time only, with no dependency on a Prometheus running anywhere.
# That is the expected shape for most of a fleet.
#
# The two halves are independent:
#
#   remote_write_url  this node PUSHES its own metrics, so a Prometheus that
#                     cannot reach it still records its history. Set it on
#                     every node whose past you want to keep.
#   query_url         this node READS ranges back, which is what puts the
#                     History tab in its dashboard. Usually set on the one node
#                     an operator opens -- the aggregator.
#
# Each node pushing its own metrics is deliberate. Having the aggregator store
# what it already polls would make one machine a time-series database whose
# cost grows with nodes x metrics x retention, on a host chosen for being
# small. Pushing is constant cost per node and adds nothing to the existing
# ones as the fleet grows.
#
# The series are labelled instance=<fleet.local_name> and job=go-sysmon, so a
# node relabelled in the fleet view is relabelled in its history too.
#
# prometheus:
#   remote_write_url: http://mon0:9090/api/v1/write
#   query_url: http://mon0:9090
#
#   # How often a sample set is taken. Deliberately separate from
#   # server.interval_ms: that is the dashboard's stream rate, and a browser
#   # watching at 250ms must not write four samples a second into a database.
#   sample_interval_ms: 15000
#
#   # How long a sample may wait before being pushed, and how many buffered
#   # samples force a push early. batch_size also bounds the backlog: ten
#   # batches worth may accumulate while the receiver is unreachable before the
#   # oldest are dropped.
#   flush_interval_ms: 30000
#   batch_size: 1000
#   timeout_ms: 10000
#
#   # Labels only a deployment knows. A name go-sysmon already uses -- instance,
#   # job, or any label its metrics carry (device, interface, resource, gpu,
#   # core, source, array, level, rule, severity, category) -- is REJECTED at
#   # load rather than ignored: a series carrying a label twice is refused by
#   # Prometheus, and it refuses the whole write request with it.
#   external_labels:
#     site: rack_3
#
# Prometheus needs remote write enabled to receive these:
#
#   prometheus --web.enable-remote-write-receiver
#
# A node that is pushing also exports its own delivery health on /metrics --
# sysmon_remote_write_{buffered_samples,consecutive_failures,
# last_success_timestamp_seconds,samples_dropped_total_current}. Alert on them:
# history that silently stops being recorded looks exactly like history that
# has not happened yet.
