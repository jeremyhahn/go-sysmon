[Unit]
# Runs the sysmon-server binary that `make deploy` installs in /usr/local/bin.
Description=go-sysmon system metrics dashboard
Documentation=https://github.com/jeremyhahn/go-sysmon
Documentation=file:/etc/go-sysmon/sysmon.env

# Binding a specific address needs the interface to have it.
After=network-online.target
Wants=network-online.target

[Service]
# Watchdog pings follow a successful self-request and a recent collection.
Type=notify
NotifyAccess=main
User=sysmon
Group=sysmon

# Defaults for variables unset in sysmon.env; the env file wins.
Environment=SYSMON_ADDR=:8081
Environment=SYSMON_INTERVAL=2000
Environment=SYSMON_LOG_LEVEL=info
EnvironmentFile=-/etc/go-sysmon/sysmon.env

ExecStart=/usr/local/bin/sysmon-server serve \
	--addr ${SYSMON_ADDR} \
	--interval ${SYSMON_INTERVAL} \
	--log-level ${SYSMON_LOG_LEVEL}

# Reloads sysmon.yaml in place; the listen address and TLS files need a restart.
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5s
# Thirty missed 2s collection ticks.
WatchdogSec=60
SyslogIdentifier=sysmon

# MemoryHigh throttles, MemoryMax kills; keep high below max or the watermark
# is unreachable. GOMEMLIMIT is derived from MemoryHigh (pkg/memlimit).
MemoryHigh=512M
MemoryMax=768M

# CPUWeight, not CPUQuota: a quota freezes the cgroup mid-burst, stalling the GC.
CPUWeight=50
TasksMax=64
# OOMScoreAdjust stays at the default: a monitor does not outrank its workload.

# CAP_SYS_ADMIN: NVMe and MegaRAID SMART passthrough ioctls.
# CAP_DAC_OVERRIDE: opening the root-only /dev/nvmeN and /dev/ipmi0 nodes.
# CAP_SYS_RAWIO is omitted: the ATA HDIO passthrough in
# pkg/collector/smart_ata.go crashes the service on some RAID-backed disks.
AmbientCapabilities=CAP_SYS_ADMIN CAP_DAC_OVERRIDE
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_OVERRIDE
NoNewPrivileges=yes
RestrictSUIDSGID=yes

# sysmon persists nothing; a writable path here would be a design change.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077

# The disk and IPMI device nodes must be visible; the disk group opens /dev/sdX.
PrivateDevices=no
SupplementaryGroups=disk

# Stricter values hide other processes and /proc/meminfo, /proc/stat and
# /proc/net/dev, and collection silently returns nothing.
ProtectProc=default
ProcSubset=all

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes

# AF_NETLINK enumerates interfaces; AF_UNIX reaches the container runtime socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
